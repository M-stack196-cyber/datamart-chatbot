{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/dtmindex\\.html",
      "dest": "/backend/app/main.py"
    },
    {
      "src": "/about\\.html",
      "dest": "/frontend/dist/about.html"
    },
    {
      "src": "/contact\\.html",
      "dest": "/frontend/dist/contact.html"
    },
    {
      "src": "/services\\.html",
      "dest": "/frontend/dist/services.html"
    },
    {
      "src": "/case-studies\\.html",
      "dest": "/frontend/dist/case-studies.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/dist/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/meeting-reminders",
      "schedule": "0 3 * * *"
    }
  ]
}
